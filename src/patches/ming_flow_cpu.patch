+    std::vector<float> prepare_cpu_rope_table(int64_t steps) {
+        const int64_t dim = hidden_ / heads_;
+        Graph temporary(execution_, 1);
+        temporary.context = ggml_init({128 * 1024, nullptr, true});
+        if (!temporary.context) throw std::runtime_error("Ming RoPE context allocation failed");
+        auto * ctx = temporary.context;
+        auto * positions = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, steps);
+        ggml_set_input(positions);
+        auto * basis = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, dim / 2, 1, steps, 1);
+        auto * identity = ggml_concat(ctx, ggml_fill(ctx, basis, 1.0f), ggml_fill(ctx, basis, 0.0f), 0);
+        auto * table = ggml_round_bf16(ctx, ggml_rope_ext(ctx, identity, positions,
+            rope_factors_.tensor, dim, GGML_ROPE_TYPE_NEOX, 0, 10000.0f,
+            1.0f, 0.0f, 1.0f, 0.0f, 0.0f));
+        ggml_set_output(table);
+        temporary.graph = ggml_new_graph_custom(ctx, 64, false);
+        ggml_build_forward_expand(temporary.graph, table);
+        temporary.allocator = ggml_gallocr_new(ggml_backend_get_default_buffer_type(execution_.backend()));
+        if (!ggml_gallocr_alloc_graph(temporary.allocator, temporary.graph)) {
+            throw std::runtime_error("Ming RoPE table allocation failed");
+        }
+        const std::array<int32_t, 3> ids{0, 1, 2};
+        ggml_backend_tensor_set(positions, ids.data(), 0, steps * sizeof(int32_t));
+        if (ggml_backend_graph_compute(execution_.backend(), temporary.graph) != GGML_STATUS_SUCCESS) {
+            throw std::runtime_error("Ming RoPE table computation failed");
+        }
+        return core::read_tensor_f32(table);
+    }
