+// Match GGML's round-to-nearest-even BF16 conversion, retaining F32 storage.
+float rounded_bf16(float value) {
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof(bits));
+    if ((bits & 0x7fffffffU) > 0x7f800000U) {
+        bits = (bits & 0xffff0000U) | 0x00400000U;
+    } else {
+        bits = (bits + 0x7fffU + ((bits >> 16) & 1U)) & 0xffff0000U;
+    }
+    std::memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+
+void rounded_rope_cpu(ggml_tensor * output, const ggml_tensor * input,
+    const ggml_tensor * table, int ith, int nth, void *) {
+    GGML_ASSERT(input->type == GGML_TYPE_F32 && table->type == GGML_TYPE_F32);
+    const int64_t dim = table->ne[0];
+    const int64_t steps = input->ne[1];
+    const int64_t heads = input->ne[0] / dim;
+    GGML_ASSERT(dim % 2 == 0 && input->ne[0] % dim == 0 && input->ne[3] == 1);
+    for (int64_t work = ith; work < input->ne[2] * steps * heads; work += nth) {
+        const int64_t head = work % heads;
+        const int64_t position = (work / heads) % steps;
+        const int64_t batch = work / (heads * steps);
+        const auto * source = reinterpret_cast<const float *>(
+            static_cast<const char *>(input->data) + batch * input->nb[2] + position * input->nb[1]) + head * dim;
+        auto * destination = reinterpret_cast<float *>(
+            static_cast<char *>(output->data) + batch * output->nb[2] + position * output->nb[1]) + head * dim;
+        const auto * factors = reinterpret_cast<const float *>(
+            static_cast<const char *>(table->data) + position * table->nb[1]);
+        for (int64_t j = 0; j < dim / 2; ++j) {
+            const float low = source[2 * j], high = source[2 * j + 1];
+            const float cosine = factors[j], sine = factors[j + dim / 2];
+            const float low_cos = rounded_bf16(low * cosine);
+            const float high_sin = rounded_bf16(high * sine);
+            const float high_cos = rounded_bf16(high * cosine);
+            const float low_sin = rounded_bf16(low * sine);
+            destination[2 * j] = rounded_bf16(low_cos - high_sin);
+            destination[2 * j + 1] = rounded_bf16(high_cos + low_sin);
+        }
+    }
+}
