+        const int64_t tts_started = tts_profile ? tts_op_now() : 0;
         const int n_fused = ggml_cpu_try_fuse_ops(cgraph, node_n, &params, cplan);
         if (n_fused > 0) {
             node_n += n_fused;
@@ -3257,6 +3276,10 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
